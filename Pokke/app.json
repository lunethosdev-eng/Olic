{
  "expo": {
    "name": "Pokke",
    "slug": "pokke",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "pokke",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pokke.music",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "app.pokke.music",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-av",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pokke necesita tu ubicaci\u00f3n para mostrar amigos cercanos y rachas de escucha en el mapa (solo si activas la funci\u00f3n experimental)."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/bubble-pop.mp3",
            "./assets/sounds/marimba.mp3",
            "./assets/sounds/twinkle.mp3",
            "./assets/sounds/joyous-chime.mp3",
            "./assets/sounds/message.mp3",
            "./assets/sounds/out-of-nowhere.mp3",
            "./assets/sounds/bubble-pop-alt.mp3",
            "./assets/sounds/marimba-bloop.mp3",
            "./assets/sounds/joyous-chime-full.mp3",
            "./assets/sounds/twinkle-alert.mp3"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "pending"
      }
    }
  }
}